   # Copy this file to .env.local and fill in your own keys.

   # Supabase (Project Settings -> API)
   NEXT_PUBLIC_SUPABASE_URL=
   NEXT_PUBLIC_SUPABASE_ANON_KEY=

   # Mapbox (account.mapbox.com -> Access tokens)
   NEXT_PUBLIC_MAPBOX_TOKEN=

   # Public site address, e.g. http://localhost:3000
   NEXT_PUBLIC_SITE_URL=

   # Anthropic (console.anthropic.com) - certificate reading and food-type classification
   ANTHROPIC_API_KEY=

   # Optional: live place details from Google
   GOOGLE_PLACES_API_KEY=

   # Import scripts only - run on your own computer, never in the browser or hosting settings
   SUPABASE_SERVICE_ROLE_KEY=
